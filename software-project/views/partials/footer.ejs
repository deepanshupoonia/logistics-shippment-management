    </div> <!-- End Container -->
    
    <footer class="bg-dark text-light py-5 mt-5 shadow-lg position-relative" style="z-index: 100;">
        <div class="container text-center">
            <p class="mb-2 fw-semibold animate__animated animate__pulse animate__infinite animate__slower">&copy; 2026 GreenLeaf Logistics. Elevating Standards.</p>
            <p class="small text-muted mb-0"><i class="bi bi-shield-check text-success"></i> Fully Data Privacy Compliant <span class="mx-2">|</span> Enterprise Dashboard v2.0</p>
        </div>
    </footer>
    
    <!-- jQuery required for DataTables -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <!-- Bootstrap Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- DataTables JS for highly interactive sorting/searching -->
    <script type="text/javascript" src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script type="text/javascript" src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    
    <script>
        $(document).ready(function() {
            // Initialize all DataTables gracefully with smooth fades
            if($('table').length > 0) {
                // Ensure table headers look uniform so sorting arrows aren't clipping
                $('table').addClass('table-striped align-middle').DataTable({
                    "pageLength": 10,
                    "lengthMenu": [[5, 10, 25, 50, -1], [5, 10, 25, 50, "All"]],
                    "language": {
                        "search": "<i class='bi bi-search'></i> Filter Records:",
                        "lengthMenu": "Show _MENU_ packages",
                        "info": "Displaying _START_ to _END_ of _TOTAL_ entries"
                    },
                    "initComplete": function() {
                        $('div.dataTables_wrapper').hide().fadeIn(500); 
                    },
                    "drawCallback": function() {
                        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
                        [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
                    }
                });
            }

            // Enable global Bootstrap tooltips (hover information)
            const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
            [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));

            // Add dynamic button ripples on click
            $('.btn').on('click', function(e) {
                $(this).addClass('animate__animated animate__pulse');
                setTimeout(() => { $(this).removeClass('animate__animated animate__pulse'); }, 500);
            });
        });
    </script>
</body>
</html>
