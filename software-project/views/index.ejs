<%- include('partials/header') %>

</div> <!-- escape default container for full width hero -->

<div class="hero-section text-center">
    <div class="container">
        <h1 class="display-4 fw-bold">GreenLeaf Logistics</h1>
        <p class="lead">Your trusted partner for robust B2B and seamless B2C deliveries.</p>
    </div>
</div>

<div class="container">
    <div class="tracking-box text-center">
        <h3 class="mb-4">Track a Package</h3>
        <form action="/tracking" method="POST" class="d-flex w-100">
            <input type="text" name="tracking_number" class="form-control form-control-lg me-2" placeholder="Enter tracking Number (e.g. GL-123)" required>
            <button type="submit" class="btn btn-success btn-lg px-4"><i class="bi bi-search"></i></button>
        </form>
    </div>

    <div class="row text-center mt-5">
        <div class="col-md-4">
            <div class="card p-4">
                <i class="bi bi-truck display-4 text-success mb-3"></i>
                <h5>Fleet Management</h5>
                <p class="text-muted">Optimized routing and active vehicle tracking.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-4">
                <i class="bi bi-shield-check display-4 text-success mb-3"></i>
                <h5>Secure & Compliant</h5>
                <p class="text-muted">Audit logs, priority processing, and data privacy.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-4">
                <i class="bi bi-headset display-4 text-success mb-3"></i>
                <h5>24/7 Support</h5>
                <p class="text-muted">High-priority customer service and operations.</p>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
